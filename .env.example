# Free key from https://www.eia.gov/opendata/register.php
EIA_API_KEY=your_key_here

# Maps Platform Weather API (WeatherNext 3 A/B). Enable the Weather API on a
# GCP project. 10k calls/month are free; this pipeline uses ~8 calls per
# nat-gas run plus ~60 for a Kalshi weather scan (72h × ~20 cities).
# https://developers.google.com/maps/documentation/weather/overview
GOOGLE_MAPS_API_KEY=

# Kalshi API (shared by weather_bot/ and kalshi/ TS client)
KALSHI_API_KEY_ID=
# Inline PEM for Vercel; local default is rsa.txt at repo root
KALSHI_PRIVATE_KEY=
# KALSHI_PRIVATE_KEY_PATH=/path/to/rsa.txt
KALSHI_PROD_DATA_BASE_URL=https://api.elections.kalshi.com/trade-api/v2

# Trading bot frontend (optional — when backend is deployed separately)
# TRADING_BOT_API_URL=https://your-backend.example.com
